# Copy to apps/backend/.env
DATABASE_URL="postgresql://civicpress:civicpress@localhost:5432/civicpress"
PORT=3000

# JWT session lifetimes (seconds)
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Notifications — email (Resend)
RESEND_API_KEY=""
MAIL_FROM="Civicpress <noreply@civicpress.ro>"

# Notifications — Signal (signal-cli-rest-api container)
SIGNAL_API_URL="http://localhost:8080"
SIGNAL_SENDER_NUMBER=""

# Admin URL used in notification message links
ADMIN_URL="http://localhost:4300/admin"

# Public site origin used in sitemap <loc> and CORS (production: https://civicpress.ro).
# Falls back to https://civicpress.ro when unset.
PUBLIC_URL="http://localhost:4200"

# Copy to apps/public/.env
VITE_API_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000"
# Canonical origin for <link rel="canonical">, Open Graph and JSON-LD (SSR).
# Production: https://civicpress.ro — do not use www.
VITE_PUBLIC_SITE_URL="https://civicpress.ro"
PUBLIC_SITE_URL="https://civicpress.ro"

# Copy to apps/admin/.env
VITE_API_BASE_URL="http://localhost:3000"
# Canonical public origin for share links in admin (production: https://civicpress.ro).
# Article preview iframe uses the current admin origin instead, so www vs apex stays same-origin.
VITE_PUBLIC_SITE_URL="http://localhost:4200"
