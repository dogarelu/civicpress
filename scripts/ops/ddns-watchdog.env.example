DOMAIN="civicpress.ro"
DNS_HOST="civicpress.ro"
AUTO_UPDATE="1"
LOG_PREFIX="civicpress-ddns"

# Optional email alert recipient; requires local mail setup.
ALERT_EMAIL=""

# Required only when AUTO_UPDATE=1 (cPanel UAPI auth).
CPANEL_HOST="cpanel.your-provider.tld"
CPANEL_USER=""
CPANEL_API_TOKEN=""

# Optional updater overrides.
TARGET_NAME="civicpress.ro."
TTL="300"
