{
  "name": "civicpress",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "concurrently -n backend,public,admin -c blue,green,yellow \"pnpm --filter @civicpress/backend dev\" \"pnpm --filter @civicpress/public dev\" \"pnpm --filter @civicpress/admin dev\"",
    "build": "pnpm --filter @civicpress/shared build && pnpm --filter @civicpress/backend build && pnpm --filter @civicpress/public build && pnpm --filter @civicpress/admin build",
    "db:up": "docker compose up -d postgres adminer",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @civicpress/backend prisma:migrate",
    "db:studio": "pnpm --filter @civicpress/backend prisma:studio",
    "seed": "pnpm --filter @civicpress/backend seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "verify:visual": "tsx scripts/verify-visual.ts",
    "verify:e2e": "playwright test",
    "e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@angular/cli": "18",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "playwright": "^1.60.0",
    "prettier": "^3.2.5",
    "tsx": "^4.22.3",
    "typescript": "~5.5.4"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.5.4"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md,css,scss,html}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@9.15.1+sha1.abc117858086cb10ecb54828d180b035cb6c8fdd",
  "dependencies": {
    "argon2": "^0.44.0"
  }
}
