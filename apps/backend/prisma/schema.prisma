generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  AUTHOR
  EDITOR
  CHIEF_EDITOR
  ADMIN
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// ─── Site branding ────────────────────────────────────────────────────────────

model SiteSettings {
  id              String  @id @default("default")
  siteName        String  @default("Civicpress")
  tagline         String?
  logoMediaId          String?
  mobileLogoMediaId    String?
  faviconMediaId       String?
  primaryColor    String  @default("#8A0808")
  secondaryColor  String  @default("#1a1a1a")
  accentColor     String  @default("#c0392b")
  backgroundColor String  @default("#ffffff")
  textColor       String  @default("#2d2d2d")
  headingFont     String  @default("Roboto")
  bodyFont        String  @default("Source Sans 3")
  headerMaxCategories Int @default(6)
  headerShowMoreDropdown Boolean @default(true)
  headerMoreCategoryIds String[] @default([])
  tickerBgColor String @default("#8A0808")
  tickerTextColor String @default("#FFFFFF")
  tickerFontWeight Int @default(600)
  /// TickerBarConfig[] — multiple header ticker bars. Null falls back to a single most-read bar.
  tickerBars Json?
  newsTitleFontSize Int @default(20)
  newsTitleFontWeight Int @default(700)
  newsSummaryFontSize Int @default(14)
  newsSummaryFontWeight Int @default(400)
  defaultSummaryRows Int @default(3)
  heroTitleFontSize Int @default(28)
  heroTitleFontWeight Int @default(800)
  sidebarTitleFontSize Int @default(13)
  sidebarTitleFontWeight Int @default(600)
  articleTitleFontSize Int @default(30)
  articleTitleFontWeight Int @default(700)
  articleContentFontSize Int @default(17)
  articleContentFontWeight Int @default(400)
  showArticleViews Boolean @default(false)
  /// 'time-if-today' | 'always-date'
  postDateFormat String @default("time-if-today")
  /// Image pill overlay: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right'
  pillCorner       String  @default("top-right")
  pillFontSize     Int     @default(12)
  /// 0 = opaque, 100 = fully transparent (background only)
  pillTransparency Int     @default(0)
  facebookUrl     String?
  twitterUrl      String?
  youtubeUrl      String?
  instagramUrl    String?
  whatsappUrl     String?
  tiktokUrl       String?
  showFacebook    Boolean @default(false)
  showTwitter     Boolean @default(false)
  showYoutube     Boolean @default(false)
  showInstagram   Boolean @default(false)
  showWhatsapp    Boolean @default(false)
  showTiktok      Boolean @default(false)
  showSocialInHeader     Boolean @default(true)
  showSocialInMobileMenu Boolean @default(true)
  showSocialInFooter     Boolean @default(true)
  footerHtml      String?
  footerContactInfo String?
  contactPageHtml String?
  termsPageHtml   String?
  privacyPageHtml String?
  cookiePageHtml  String?

  logoMedia       Media? @relation("logo", fields: [logoMediaId], references: [id])
  mobileLogoMedia Media? @relation("mobileLogo", fields: [mobileLogoMediaId], references: [id])
  faviconMedia    Media? @relation("favicon", fields: [faviconMediaId], references: [id])
}

// ─── Layout ───────────────────────────────────────────────────────────────────

/// One row per page kind: 'home' | 'category' | 'article'.
/// `config` is a PageLayoutConfig JSON (see @civicpress/shared).
model PageLayout {
  id        String   @id
  config    Json
  updatedAt DateTime @updatedAt
}

// ─── Media ────────────────────────────────────────────────────────────────────

model Media {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  width     Int?
  height    Int?
  sizeBytes Int?
  alt       String?
  caption   String?
  path      String
  variants  Json?
  ownerId   String?
  createdAt DateTime @default(now())

  owner           User?          @relation("mediaOwner", fields: [ownerId], references: [id])
  posts           Post[]         @relation("heroMedia")
  settingsLogo       SiteSettings[] @relation("logo")
  settingsMobileLogo SiteSettings[] @relation("mobileLogo")
  settingsFavicon    SiteSettings[] @relation("favicon")
  userAvatars        User[]         @relation("userAvatar")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  slug          String    @unique
  bio           String?
  role          Role      @default(AUTHOR)
  avatarMediaId String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())

  notificationEmail  String?
  signalNumber       String?
  notifyReviewEmail  Boolean @default(false)
  notifyReviewSignal Boolean @default(false)
  pseudonyms         String[] @default([])

  avatar         Media?     @relation("userAvatar", fields: [avatarMediaId], references: [id])
  media          Media[]    @relation("mediaOwner")
  posts          Post[]     @relation("postAuthor")
  submittedPosts Post[]     @relation("postSubmitter")
  approvedPosts  Post[]     @relation("postApprover")
  revisions      Revision[]
  auditLogs      AuditLog[]
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  color       String?
  description String?
  parentId    String?
  showInMenu       Boolean @default(true)
  showInMobileMenu Boolean @default(true)
  showInMobileRow  Boolean @default(true)
  menuOrder        Int     @default(0)
  externalId  String? @unique

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  posts    PostCategory[]
}

// ─── Pill (image overlay badge) ───────────────────────────────────────────────

model Pill {
  id        String    @id @default(cuid())
  text      String
  color     String
  textColor String    @default("#ffffff")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  postPills PostPill[]
}

// ─── Tag ──────────────────────────────────────────────────────────────────────

model Tag {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  externalId String?  @unique
  posts      PostTag[]
}

// ─── Post ─────────────────────────────────────────────────────────────────────

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  /// Plain-text kicker shown above the title on the article page only.
  kicker         String?
  excerpt        String?
  contentHtml    String     @default("")
  heroMediaId    String?
  videoUrl       String?
  authorId       String?
  authorName     String?
  showDate       Boolean    @default(true)
  showAuthor     Boolean    @default(true)
  showSummary    Boolean    @default(false)
  viewCount      Int        @default(0)
  /// When true, auto-fill skips this post in homepage/category/article modules.
  /// Explicit pins (e.g. video-list items) still resolve it.
  excludeFromModules Boolean @default(false)
  status         PostStatus @default(DRAFT)
  scheduledFor   DateTime?
  submittedById  String?
  approvedById   String?
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  externalId     String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  /// Set when the article is moved to trash. Cleared on restore. Purged after 30 days.
  deletedAt      DateTime?
  /// Article shown beside this one on its page. The sibling's own page stays single.
  siblingPostId  String?

  heroMedia   Media?         @relation("heroMedia", fields: [heroMediaId], references: [id])
  siblingPost Post?          @relation("PostSibling", fields: [siblingPostId], references: [id], onDelete: SetNull)
  siblingOf   Post[]         @relation("PostSibling")
  author      User?          @relation("postAuthor", fields: [authorId], references: [id])
  submittedBy User?          @relation("postSubmitter", fields: [submittedById], references: [id])
  approvedBy  User?          @relation("postApprover", fields: [approvedById], references: [id])
  categories  PostCategory[]
  tags        PostTag[]
  postPills   PostPill[]
  bulbi         PostBulb[]         @relation("PostBulbs")
  bulbOfPosts   PostBulb[]         @relation("PostBulbLinks")
  photoCaptions PostPhotoCaption[]
  revisions     Revision[]

  @@index([deletedAt])
  @@index([siblingPostId])
}

// ─── Join tables ──────────────────────────────────────────────────────────────

model PostCategory {
  postId     String
  categoryId String
  isPrimary  Boolean @default(false)

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

/// Image pill placements on a post (max 4; unique pill; unique corner when set).
model PostPill {
  postId String
  pillId String
  /// Corner; null only allowed when the post has exactly one pill (uses global default).
  corner String?
  /// 'smaller' | 'default' | 'bigger' — relative to the layout/global default size
  size   String @default("default")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  pill Pill @relation(fields: [pillId], references: [id], onDelete: Cascade)

  @@id([postId, pillId])
  @@index([pillId])
}

/// Subtitle bullet ("bumb"): optional link to another article or an external URL.
model PostBulb {
  id           String  @id @default(cuid())
  postId       String
  linkedPostId String?
  externalUrl  String?
  sortOrder    Int
  label        String

  post       Post  @relation("PostBulbs", fields: [postId], references: [id], onDelete: Cascade)
  linkedPost Post? @relation("PostBulbLinks", fields: [linkedPostId], references: [id], onDelete: SetNull)

  @@index([postId, sortOrder])
}

/// Caption under a photo on the article page, applied in document order.
model PostPhotoCaption {
  id        String @id @default(cuid())
  postId    String
  sortOrder Int
  label     String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

// ─── Revision ─────────────────────────────────────────────────────────────────

model Revision {
  id          String   @id @default(cuid())
  postId      String
  title       String
  excerpt     String?
  contentHtml String
  editorId    String?
  message     String?
  createdAt   DateTime @default(now())

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  editor User? @relation(fields: [editorId], references: [id])

  @@index([postId, createdAt])
}

// ─── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ─── Analytics (first-party) ──────────────────────────────────────────────────

/// Simple UTM codes for share links (`?utm=code`), managed from admin share modal.
model UtmPreset {
  id        String   @id @default(cuid())
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Browser session (client-generated id). First-touch UTM is sticky for the session.
model AnalyticsSession {
  id          String   @id
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Persistent anonymous visitor (localStorage). Distinct from short-lived sessionId.
  visitorId   String?
  /// Value of `?utm=` on first touch (null = no UTM).
  utm         String?
  utmPresetId String?
  userAgent   String?

  pageViews AnalyticsPageView[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId])
  @@index([utm])
}

model AnalyticsPageView {
  id         String   @id
  sessionId  String
  path       String
  pageType   String
  postId     String?
  title      String?
  startedAt  DateTime @default(now())
  durationMs Int      @default(0)
  /// Denormalized first-touch UTM from the session (for aggregation).
  utm        String?

  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([path, startedAt])
  @@index([postId, startedAt])
  @@index([pageType, startedAt])
  @@index([startedAt])
  @@index([utm, startedAt])
}

